  "productName": "KoaTeam",
  "version": "0.1.0",
  "identifier": "fr.koa-dev.koateam",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "KoaTeam",
